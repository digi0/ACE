# ── ACE frontend env ────────────────────────────────────────────
# Copy to `.env` (committed defaults) and/or `.env.local` (local overrides).

# Clerk publishable key (Clerk Dashboard → API Keys).
# Use pk_test_... for the dev instance, pk_live_... in production.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API base URL. Optional — defaults to http://127.0.0.1:8000.
# In production set this to your deployed backend, e.g.
# https://your-api.up.railway.app
VITE_API_URL=http://127.0.0.1:8000

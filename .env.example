# ── ACE backend env ─────────────────────────────────────────────
# Copy to `.env` at the repo root. This file is the template — do NOT
# put real secrets here.

# OpenAI — chat (gpt-4o-mini) + embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Clerk — backend session verification (Clerk Dashboard → API Keys).
# Use sk_test_... for the dev instance, sk_live_... in production.
CLERK_SECRET_KEY=sk_test_...

# Allowed origins (CSV). Drives BOTH CORS and Clerk authorized_parties.
# Local dev defaults are baked into the app; in a deployment set this to
# your frontend origin(s), e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional
LOG_LEVEL=INFO
# DATABASE_URL — injected by Railway in prod; falls back to SQLite
# (backend/data/ace_users.db) locally.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
